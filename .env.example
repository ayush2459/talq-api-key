# Local development only: never commit your actual .env file
ADMIN_API_KEY=replace-with-a-long-random-admin-secret
DATABASE_URL=sqlite:///./flowsense_talq.db
TALQ_CLIENT_ADDRESS=
DEMO_MODE=true

# API-key lifecycle
API_KEY_LIFETIME_DAYS=90
TELEGRAM_VERIFICATION_MINUTES=30
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Telegram BotFather settings; keep token and webhook secret private.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
