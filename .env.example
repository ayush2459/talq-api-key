# Local development only: never commit your actual .env file
ADMIN_API_KEY=replace-with-a-long-random-admin-secret
DATABASE_URL=sqlite:///./flowsense_talq.db
TALQ_CLIENT_ADDRESS=
DEMO_MODE=true

# API-key lifecycle
API_KEY_LIFETIME_DAYS=90
EMAIL_VERIFICATION_MINUTES=30
PUBLIC_BASE_URL=http://127.0.0.1:8000

# SMTP is required to email verification tokens. Use provider SMTP credentials.
# Keep these values in Render secret environment variables, not in Git.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_STARTTLS=true
